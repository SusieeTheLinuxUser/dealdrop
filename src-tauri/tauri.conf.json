{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DealDrop",
  "version": "0.6.0",
  "identifier": "com.dealdrop.desktop",
  "build": { "frontendDist": "../renderer" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DealDrop",
        "width": 980,
        "height": 660,
        "minWidth": 760,
        "minHeight": 540,
        "decorations": false,
        "backgroundColor": "#0e1117"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Game sale, giveaway & wishlist notifier"
  }
}
